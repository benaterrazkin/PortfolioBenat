---
/**
 * El marcador del menú: enciende en la cabecera el enlace de la sección
 * por la que se va pasando (proyectos, contacto).
 *
 * Antes había además un carril de puntos en el lateral, un atajo por
 * cuaderno; con los cuadernos fuera de la página, la web es corta y ya no
 * hacía falta.
 */
---

<script>
  const enlacesMenu = new Map<string, HTMLElement[]>();
  for (const enlace of document.querySelectorAll<HTMLElement>('[data-ancla]')) {
    const clave = enlace.dataset.ancla!;
    enlacesMenu.set(clave, [...(enlacesMenu.get(clave) ?? []), enlace]);
  }

  const marcar = (clave: string | undefined) => {
    for (const [nombre, elementos] of enlacesMenu) {
      for (const elemento of elementos) {
        elemento.toggleAttribute('data-activo', nombre === clave);
        if (nombre === clave) elemento.setAttribute('aria-current', 'true');
        else elemento.removeAttribute('aria-current');
      }
    }
  };

  /* Cuenta la sección que cruza la franja central de la ventana: así rara
   * vez hay dos encendidas a la vez. */
  const vigia = new IntersectionObserver(
    (entradas) => {
      for (const entrada of entradas) {
        if (!entrada.isIntersecting) continue;
        const el = entrada.target as HTMLElement;
        marcar(el.dataset.menu ?? el.dataset.seccion);
      }
    },
    { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
  );

  /* Solo las secciones de la página: los cuadernos van dentro de su ventana. */
  for (const seccion of document.querySelectorAll('main > [data-seccion]')) vigia.observe(seccion);
</script>
