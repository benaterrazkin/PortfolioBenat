---
import TituloSeccion from './TituloSeccion.astro';
import Estante from './Estante.astro';
import { cuadernos } from '../data/cuaderno';
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';

/**
 * Los proyectos: la pila de cuadernos, apoyada en la misma mesa sobre la
 * que luego se abren (VisorCuaderno.astro).
 */
interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos(idioma);
const hay = cuadernos(idioma).length > 0;
---

<section id="proyectos" class="anclada border-t border-linea" data-seccion="proyectos">
  <TituloSeccion titulo={t.proyectos.titulo} entradilla={t.proyectos.entradilla} />

  {
    hay ? (
      <div class="mesa py-10 md:py-14">
        <div class="contenedor">
          <Estante idioma={idioma} />
        </div>
      </div>
    ) : (
      <p class="contenedor pb-24 text-gris">{t.proyectos.vacio}</p>
    )
  }
</section>

<style>
  /* La misma mesa con retícula que hay bajo los cuadernos abiertos. */
  .mesa {
    background-color: var(--color-mesa);
    background-image:
      linear-gradient(to right, rgb(20 22 26 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(20 22 26 / 0.05) 1px, transparent 1px);
    background-size: 5rem 5rem;
  }
</style>
