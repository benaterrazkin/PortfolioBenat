---
import TituloSeccion from './TituloSeccion.astro';
import Estante from './Estante.astro';
import { cuadernos } from '../data/cuaderno';
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';

/**
 * Los proyectos: el estante con un libro por proyecto. Los cuadernos se
 * abren encima al pulsar un libro (VisorCuaderno.astro), no van aquí.
 */
interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos(idioma);
const hay = cuadernos(idioma).length > 0;
---

<section id="proyectos" class="anclada border-t border-linea pb-20 md:pb-28" data-seccion="proyectos">
  <TituloSeccion indice="02" titulo={t.proyectos.titulo} entradilla={t.proyectos.entradilla} />

  <div class="contenedor">
    {hay ? <Estante idioma={idioma} /> : <p class="pb-24 text-gris">{t.proyectos.vacio}</p>}
  </div>
</section>
