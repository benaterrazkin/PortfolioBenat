---
import { Image } from 'astro:assets';
import type { Cara } from '../data/cuaderno';
import { textos, formatear } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';

/**
 * Una cara del cuaderno: media doble página. Las hay de cinco clases
 * (portadilla, texto, imagen, blanca y cierre) y todas miden lo mismo,
 * para que al pasar la hoja no se vea ningún salto.
 */
interface Props {
  cara: Cara;
  idioma: Idioma;
  /** Número del cuaderno y total, para el cierre. */
  numeroCuaderno: number;
  totalCuadernos: number;
  /** Ancla del siguiente cuaderno, para el enlace del cierre. */
  anclaSiguiente?: string;
  tituloSiguiente?: string;
  /** La primera imagen de la web se carga de inmediato: es la que se ve. */
  prioritaria?: boolean;
  /** "anverso" o "reverso" dentro de una hoja; vacío en las dos fijas. */
  lado?: 'anverso' | 'reverso' | 'izquierda' | 'derecha';
}

const {
  cara,
  idioma,
  numeroCuaderno,
  totalCuadernos,
  anclaSiguiente,
  tituloSiguiente,
  prioritaria = false,
  lado,
} = Astro.props;

const t = textos(idioma);

const clases = [
  'cara',
  lado === 'anverso' && 'cara--anverso',
  lado === 'reverso' && 'cara--reverso',
  lado === 'izquierda' && 'cara--base cara--izquierda',
  lado === 'derecha' && 'cara--base cara--derecha',
  cara.tipo === 'imagen' && 'cara--imagen',
  cara.tipo === 'blanca' && 'reticula',
];
---

<div class:list={clases} data-cara={cara.indice}>
  {
    cara.tipo === 'portadilla' && (
      <div class="cara-caja flex flex-col justify-between">
        <div>
          <p class="indice">{String(numeroCuaderno).padStart(2, '0')}</p>
          <h3 class="mt-4 font-[family-name:var(--font-titulo)] text-[clamp(1.75rem,3.2vw,3rem)] leading-[0.98] tracking-tight">
            {cara.titulo}
          </h3>
          {cara.subtitulo && (
            <p class="mt-4 text-[clamp(0.875rem,1.1vw,1.0625rem)] text-gris leading-relaxed max-w-[38ch]">
              {cara.subtitulo}
            </p>
          )}
        </div>

        <dl class="mt-6 grid gap-2 border-t border-linea pt-4 text-[clamp(0.75rem,0.9vw,0.875rem)]">
          <div class="flex gap-4">
            <dt class="rotulo text-gris w-28 shrink-0">{t.proyectos.ficha.anio}</dt>
            <dd class="tabular-nums">{cara.ficha.anio}</dd>
          </div>
          {cara.ficha.lugar && (
            <div class="flex gap-4 border-t border-linea-suave pt-2">
              <dt class="rotulo text-gris w-28 shrink-0">{t.proyectos.ficha.lugar}</dt>
              <dd>{cara.ficha.lugar}</dd>
            </div>
          )}
          {cara.ficha.tipo && (
            <div class="flex gap-4 border-t border-linea-suave pt-2">
              <dt class="rotulo text-gris w-28 shrink-0">{t.proyectos.ficha.tipo}</dt>
              <dd>{cara.ficha.tipo}</dd>
            </div>
          )}
          {cara.ficha.contexto && (
            <div class="flex gap-4 border-t border-linea-suave pt-2">
              <dt class="rotulo text-gris w-28 shrink-0">{t.proyectos.ficha.contexto}</dt>
              <dd>{cara.ficha.contexto}</dd>
            </div>
          )}
          {cara.ficha.herramientas.length > 0 && (
            <div class="flex gap-4 border-t border-linea-suave pt-2">
              <dt class="rotulo text-gris w-28 shrink-0">{t.proyectos.ficha.herramientas}</dt>
              <dd>{cara.ficha.herramientas.join(' · ')}</dd>
            </div>
          )}
        </dl>
      </div>
    )
  }

  {
    cara.tipo === 'texto' && (
      <div class="cara-caja flex flex-col justify-center">
        {cara.parrafos.map((parrafo) => (
          <p class="mt-4 first:mt-0 text-[clamp(0.875rem,1.05vw,1.0625rem)] leading-relaxed max-w-[46ch]">
            {parrafo}
          </p>
        ))}
      </div>
    )
  }

  {
    cara.tipo === 'imagen' && (
      <figure class="cara-caja flex flex-col h-full">
        <div class="flex-1 min-h-0 flex items-center justify-center">
          <Image
            src={cara.imagen.fuente}
            alt={cara.imagen.alt}
            widths={[640, 1024, 1440, 2000]}
            sizes="(min-width: 60rem) 46vw, 92vw"
            class="max-w-full max-h-full w-auto h-auto object-contain"
            loading={prioritaria ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={prioritaria ? 'high' : undefined}
          />
        </div>
        <figcaption class="mt-3 flex items-baseline gap-4 border-t border-linea-suave pt-2 shrink-0">
          <span class="indice">{String(cara.numero).padStart(2, '0')}</span>
          <span class="text-[0.75rem] text-gris truncate">{cara.imagen.pie ?? ''}</span>
        </figcaption>
      </figure>
    )
  }

  {
    cara.tipo === 'blanca' && <p class="sr-only">{t.cuaderno.enBlanco}</p>
  }

  {
    cara.tipo === 'cierre' && (
      <div class="cara-caja flex flex-col justify-between items-start">
        <p class="rotulo text-gris">{t.cuaderno.fin}</p>

        <div>
          <p class="indice">
            {formatear('{n} / {total}', { n: numeroCuaderno, total: totalCuadernos })}
          </p>
          <p class="mt-3 font-[family-name:var(--font-titulo)] text-[clamp(1.25rem,2vw,1.75rem)] tracking-tight">
            {cara.titulo}
          </p>
          <p class="mt-1 rotulo text-gris tabular-nums">{cara.anio}</p>
        </div>

        {anclaSiguiente ? (
          <a
            href={`#${anclaSiguiente}`}
            class="rotulo text-gris inline-flex items-center gap-3 hover:text-tinta transition-colors"
          >
            {t.cuaderno.siguienteProyecto}
            <span aria-hidden="true" class="w-6 h-px bg-current" />
            <span class="text-tinta">{tituloSiguiente}</span>
          </a>
        ) : (
          <span />
        )}
      </div>
    )
  }
</div>

<style>
  /* El respiro de dentro de la hoja. Se separa del borde lo justo para
     que se lea como papel y no como una caja de web. */
  .cara-caja {
    height: 100%;
    padding: clamp(1.25rem, 2.4vw, 2.75rem);
  }
  /* Las imágenes respiran menos: son las protagonistas. */
  .cara--imagen .cara-caja {
    padding: clamp(1rem, 1.6vw, 1.75rem);
  }
</style>
