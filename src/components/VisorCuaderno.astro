---
import Cuaderno from './Cuaderno.astro';
import { cuadernos } from '../data/cuaderno';
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';

/**
 * La ventana de los cuadernos.
 *
 * Los cuadernos ya no están en la página, uno detrás de otro: se abren
 * aquí, a pantalla completa y sobre la mesa, cuando se elige un libro del
 * estante. Están todos dentro, ocultos, y solo se ve el elegido.
 *
 * Funciona con la dirección: cada cuaderno es #cuaderno-<id>. Pulsar un
 * libro cambia el #, y el cambio abre la ventana; así "atrás" en el
 * navegador la cierra, y quien abre un enlace con el # entra con ese
 * cuaderno ya abierto. Va una sola vez por página.
 */
interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos(idioma);
const lista = cuadernos(idioma);
---

<dialog id="visor-cuaderno" class="visor ventana" aria-label={t.proyectos.titulo}>
  <div class="visor-barra">
    <!-- Cómo se usa, la primera vez. Se va en cuanto se pasa una hoja. -->
    <p class="visor-ayuda" data-ayuda>{t.cuaderno.ayuda}</p>

    <!-- Anterior / siguiente dicen a qué proyecto llevan. El nombre lo pone
         el script al abrir cada cuaderno. -->
    <button type="button" class="visor-boton" data-paso-proyecto="-1" title={t.cuaderno.anteriorProyecto}>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="visor-icono" fill="none" stroke="currentColor" stroke-width="1.25">
        <path d="M19 12H5m0 0 6-6m-6 6 6 6"></path>
      </svg>
      <span class="sr-only">{t.cuaderno.anteriorProyecto}:</span>
      <span data-destino></span>
    </button>
    <button type="button" class="visor-boton" data-paso-proyecto="1" title={t.cuaderno.siguienteProyecto}>
      <span class="sr-only">{t.cuaderno.siguienteProyecto}:</span>
      <span data-destino></span>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="visor-icono" fill="none" stroke="currentColor" stroke-width="1.25">
        <path d="M5 12h14m0 0-6-6m6 6-6 6"></path>
      </svg>
    </button>
    <button type="button" class="visor-boton visor-cerrar" data-cerrar-cuaderno aria-label={t.general.cerrar}>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="visor-icono" fill="none" stroke="currentColor" stroke-width="1.25">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>

  <div class="visor-cuerpo">
    {
      lista.map((c, i) => (
        <div data-panel={c.ancla} data-nombre={c.nombreCorto} data-titulo={c.titulo} hidden>
          <Cuaderno
            cuaderno={c}
            idioma={idioma}
            total={lista.length}
            primero={i === 0}
            anclaSiguiente={lista.length > 1 ? lista[(i + 1) % lista.length]!.ancla : undefined}
            tituloSiguiente={lista.length > 1 ? lista[(i + 1) % lista.length]!.titulo : undefined}
          />
        </div>
      ))
    }
  </div>
</dialog>

<style>
  .visor {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--color-mesa);
    overflow-y: auto;
    overscroll-behavior: contain;
    /* La entrada y la salida las pone .ventana (global.css). */
    --fondo-ventana: rgb(20 22 26 / 0.6);
  }
  /* Abierta, la ventana es una columna: la barra arriba y el cuaderno
     centrado en el alto que queda. */
  .visor[open] {
    display: flex;
    flex-direction: column;
  }
  .visor-cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .visor-barra {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background-color: color-mix(in srgb, var(--color-mesa) 88%, transparent);
    backdrop-filter: blur(6px);
  }
  @media (width >= 48rem) {
    .visor-barra { padding-inline: 4rem; }
  }

  .visor-boton {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding-inline: 0.875rem;
    border: 1px solid rgb(20 22 26 / 0.35);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-tinta);
    transition:
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .visor-boton:active {
    transform: scale(0.97);
  }
  .visor-boton:hover,
  .visor-boton:focus-visible {
    background-color: var(--color-tinta);
    color: var(--color-papel);
  }
  .visor-cerrar {
    width: 2.25rem;
    justify-content: center;
    padding: 0;
  }
  .visor-icono {
    width: 1rem;
    height: 1rem;
    flex: none;
  }
  /* La ayuda ocupa el sitio libre de la izquierda; en pantallas estrechas
     no cabe y el cuaderno ya enseña sus flechas. */
  .visor-ayuda {
    display: none;
    margin-right: auto;
    align-self: center;
    font-size: 0.8125rem;
    color: var(--color-tinta);
    transition: opacity 200ms ease;
  }
  @media (width >= 48rem) {
    .visor-ayuda { display: block; }
  }
  .visor-ayuda[data-oculta] {
    opacity: 0;
    pointer-events: none;
  }

  /* Dentro de la ventana el cuaderno ya está sobre la mesa: sin el aire
     de arriba que llevaba cuando iba en la página. */
  .visor-cuerpo :global(.cuaderno-seccion) {
    padding-block: 0.5rem 3rem;
    background-color: transparent;
  }
</style>

<script>
  const elemento = document.getElementById('visor-cuaderno');

  if (elemento instanceof HTMLDialogElement) {
    const visor: HTMLDialogElement = elemento;
    const paneles = Array.from(visor.querySelectorAll<HTMLElement>('[data-panel]'));
    const anclas = paneles.map((p) => p.dataset.panel!);
    let actual = -1;
    /* Si la ventana se abrió desde la propia web (pulsando un libro), al
     * cerrarla se vuelve atrás en el historial; si se entró con el # en la
     * dirección, solo se limpia el #. */
    let desdeLaWeb = false;
    let desdeDonde: HTMLElement | null = null;

    const anclaDelHash = () => decodeURIComponent(location.hash.slice(1));

    function abrir(ancla: string) {
      const i = anclas.indexOf(ancla);
      if (i === -1) return;
      actual = i;
      paneles.forEach((p, j) => (p.hidden = j !== i));
      if (!visor.open) {
        desdeDonde = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        visor.showModal();
        document.documentElement.style.overflow = 'hidden';
      }
      visor.scrollTop = 0;
      /* La ventana se anuncia con el nombre del proyecto, y anterior /
       * siguiente dicen adónde llevan. */
      visor.setAttribute('aria-label', paneles[i]!.dataset.titulo ?? '');
      const vecino = (paso: number) => paneles[(i + paso + paneles.length) % paneles.length]!;
      for (const boton of visor.querySelectorAll<HTMLElement>('[data-paso-proyecto]')) {
        const destino = boton.querySelector('[data-destino]');
        if (destino) destino.textContent = vecino(Number(boton.dataset.pasoProyecto)).dataset.nombre ?? '';
      }
      /* Se abre por la ficha y el texto, no por la tapa cerrada. */
      const cuaderno = paneles[i]!.querySelector<HTMLElement>('[data-cuaderno]');
      cuaderno?.dispatchEvent(new CustomEvent('cuaderno:abrir'));
      /* El foco al cuaderno: así las flechas del teclado pasan las hojas. */
      cuaderno?.focus({ preventScroll: true });
    }

    /* La ayuda de la barra se va en cuanto se pasa la primera hoja, y no
     * vuelve en el resto de la visita. */
    const ayuda = visor.querySelector<HTMLElement>('[data-ayuda]');
    const ocultarAyuda = () => {
      ayuda?.setAttribute('data-oculta', '');
      try {
        sessionStorage.setItem('cuaderno-ayuda-vista', '1');
      } catch {
        /* Sin almacenamiento, la ayuda se oculta solo en esta página. */
      }
    };
    try {
      if (sessionStorage.getItem('cuaderno-ayuda-vista')) ayuda?.setAttribute('data-oculta', '');
    } catch {
      /* Sin almacenamiento, se enseña. */
    }
    visor.addEventListener('click', (evento) => {
      if ((evento.target as HTMLElement).closest('.zona')) ocultarAyuda();
    });
    visor.addEventListener('keydown', (evento) => {
      if (evento.key === 'ArrowRight' || evento.key === 'ArrowLeft') ocultarAyuda();
    });

    function alCerrar() {
      actual = -1;
      document.documentElement.style.overflow = '';
      if (anclas.includes(anclaDelHash())) {
        if (desdeLaWeb) history.back();
        else history.replaceState(history.state, '', location.pathname + location.search);
      }
      desdeLaWeb = false;
      desdeDonde?.focus({ preventScroll: true });
    }

    /* El # manda: cambia el #, se abre (o se cierra) la ventana. */
    window.addEventListener('hashchange', () => {
      const ancla = anclaDelHash();
      if (anclas.includes(ancla)) {
        desdeLaWeb = true;
        abrir(ancla);
      } else if (visor.open) {
        desdeLaWeb = false;
        visor.close();
      }
    });

    /* Entrar con el # en la dirección abre el cuaderno directamente. */
    if (anclas.includes(anclaDelHash())) abrir(anclaDelHash());

    visor.addEventListener('close', alCerrar);
    visor.querySelector('[data-cerrar-cuaderno]')?.addEventListener('click', () => visor.close());

    /* El enlace "siguiente proyecto" de la contratapa, ya dentro de la
     * ventana: cambia de cuaderno sin apilar historial, o al cerrar se
     * volvería al cuaderno anterior en vez de a la web. */
    visor.addEventListener('click', (evento) => {
      const enlace = (evento.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
      const ancla = enlace?.getAttribute('href')?.slice(1);
      if (!ancla || !anclas.includes(ancla)) return;
      evento.preventDefault();
      history.replaceState(history.state, '', `#${ancla}`);
      abrir(ancla);
    });

    /* Proyecto anterior / siguiente: se cambia el # sin apilar historial. */
    for (const boton of visor.querySelectorAll<HTMLElement>('[data-paso-proyecto]')) {
      boton.addEventListener('click', () => {
        if (actual === -1) return;
        const paso = Number(boton.dataset.pasoProyecto);
        const siguiente = anclas[(actual + paso + anclas.length) % anclas.length]!;
        history.replaceState(history.state, '', `#${siguiente}`);
        abrir(siguiente);
      });
    }
  }
</script>
