---
import { Image, getImage } from 'astro:assets';
import { imagen as buscarImagen, type Imagen } from '../data';
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';

/**
 * Las imágenes de un proyecto, a toda anchura y en el orden en el que están
 * escritas. Al pulsar una se abre a pantalla completa (ver VisorImagenes).
 */
interface Props {
  imagenes: Imagen[];
  /** Identificador del grupo: las flechas del visor se mueven solo dentro de él. */
  grupo: string;
  idioma: Idioma;
}

const { imagenes, grupo, idioma } = Astro.props;
const t = textos(idioma);

const preparadas = await Promise.all(
  imagenes.map(async (im) => {
    const fuente = buscarImagen(im.archivo);
    const grande = await getImage({ src: fuente, width: 2000, format: 'webp', quality: 82 });
    return { ...im, fuente, grande: grande.src };
  }),
);
---

{
  preparadas.length > 0 && (
    <section class="mt-16">
      <h2 class="sr-only">{t.proyectos.galeria}</h2>
      <ul class="grid gap-12">
        {preparadas.map((im, i) => (
          <li>
            <figure>
              <button
                type="button"
                class="group block w-full border border-linea bg-papel-2 overflow-hidden"
                data-galeria={grupo}
                data-grande={im.grande}
                data-alt={im.alt}
                aria-label={`${t.proyectos.ampliar}: ${im.alt}`}
              >
                <Image
                  src={im.fuente}
                  alt={im.alt}
                  widths={[640, 1024, 1600]}
                  sizes="(min-width: 80rem) 72rem, 100vw"
                  class="w-full h-auto transition-opacity duration-300 group-hover:opacity-90"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </button>
              <figcaption class="mt-3 flex items-baseline gap-4 border-t border-linea-suave pt-2.5">
                <span class="indice">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-sm text-gris">{im.pie ?? im.alt}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}
