---
import { Image } from 'astro:assets';
import type { LaminaDeCara } from '../data/cuaderno';

/**
 * La tapa de un cuaderno: número, boceto, título y la franja de datos.
 *
 * La misma tapa sale en dos sitios: en la pila de cuadernos de la portada
 * (pequeña) y como primera cara del cuaderno abierto (grande). Para que se
 * vea idéntica en los dos, todo se mide contra su propio ancho (unidades
 * cqw de container queries), no contra la ventana.
 *
 * Solo dibuja el contenido: el corcho y la cinta del lomo los pone quien
 * la contiene (.cara--tapa en el cuaderno, .libro en la pila).
 */
interface Props {
  numero: number;
  titulo: string;
  claves: string[];
  herramientas: string[];
  lamina?: LaminaDeCara;
  /** Texto del hueco cuando todavía no hay boceto. */
  rotuloHueco: string;
  /** La tapa que se ve nada más cargar se pide de inmediato. */
  prioritaria?: boolean;
}

const { numero, titulo, claves, herramientas, lamina, rotuloHueco, prioritaria = false } = Astro.props;
---

<div class="tapa">
  <div class="tapa-caja">
    <p class="tapa-numero">{String(numero).padStart(2, '0')}</p>

    {
      lamina ? (
        <div class="tapa-boceto">
          <Image
            src={lamina.fuente}
            alt={lamina.alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 60rem) 40vw, 85vw"
            loading={prioritaria ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ) : (
        <div class="tapa-boceto tapa-hueco">
          <span>{rotuloHueco}</span>
        </div>
      )
    }

    <div class="tapa-pie">
      <h3 class="tapa-titulo">{titulo}</h3>
      {/* La franja de abajo: los datos del proyecto a la izquierda y los
          programas pegados al borde derecho, línea contra línea. */}
      <div class="tapa-datos">
        <ul>{claves.map((clave) => <li>{clave}</li>)}</ul>
        <ul class="tapa-programas">{herramientas.map((h) => <li>{h}</li>)}</ul>
      </div>
    </div>
  </div>
</div>

<style>
  .tapa {
    height: 100%;
    container-type: inline-size;
    color: var(--color-tinta);
  }

  /* Mucho aire arriba y poco abajo: el título y la franja se apoyan cerca
     del canto inferior. A la izquierda se deja sitio a la cinta del lomo. */
  .tapa-caja {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 11cqw 8cqw 7cqw 14cqw;
  }

  .tapa-numero {
    flex: none;
    font-family: var(--font-titulo);
    font-size: clamp(0.5625rem, 2.7cqw, 0.8125rem);
    font-weight: 500;
    letter-spacing: 0.18em;
    font-variant-numeric: tabular-nums;
  }

  .tapa-boceto {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: 6cqw;
  }
  .tapa-boceto :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  /* Mientras no haya boceto, un recuadro de trazos con su rótulo. */
  .tapa-hueco {
    margin-block: 2.5cqw;
    border: 1px dashed rgb(20 22 26 / 0.38);
    font-family: var(--font-titulo);
    font-size: clamp(0.5625rem, 1.7cqw, 0.75rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .tapa-pie {
    flex: none;
  }
  .tapa-titulo {
    max-width: 22ch;
    font-family: var(--font-titulo);
    font-weight: 600;
    font-size: clamp(1rem, 6.4cqw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .tapa-datos {
    margin-top: 3cqw;
    padding-top: 2.4cqw;
    border-top: 1px solid rgb(20 22 26 / 0.4);
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 6%;
    align-items: start;
    font-family: var(--font-titulo);
    font-size: clamp(0.5rem, 2.4cqw, 0.8125rem);
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1.45;
    text-transform: uppercase;
  }
  .tapa-programas {
    text-align: right;
  }
</style>
