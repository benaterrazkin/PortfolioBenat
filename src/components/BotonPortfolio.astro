---
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';
import { recurso } from '../rutas';
import { SITIO } from '../config/sitio';

/**
 * Botón que descarga el portfolio completo en PDF.
 *
 * A diferencia del currículum, que se lee dentro de la web, esto es un
 * documento para mandar a un estudio: se baja directamente. El PDF se
 * genera al compilar desde los mismos proyectos que se ven en los
 * cuadernos (ver src/pages/portfolio/[idioma].pdf.ts), uno por idioma,
 * así que nunca puede quedarse desfasado respecto a la web.
 */
interface Props {
  /** "relleno" para el botón principal, "linea" para el secundario. */
  tono?: 'relleno' | 'linea';
  clase?: string;
  idioma: Idioma;
}

const { idioma, tono = 'linea', clase = '' } = Astro.props;
const t = textos(idioma);

const estilos =
  tono === 'relleno'
    ? 'bg-tinta text-papel border-tinta hover:bg-papel hover:text-tinta'
    : 'border-tinta text-tinta hover:bg-tinta hover:text-papel';

/* El nombre con el que se guarda en el ordenador de quien lo descarga. */
const archivo = `${SITIO.nombreCompleto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '-')}-Portfolio-${idioma}.pdf`;
---

<a
  href={recurso(`portfolio/${idioma}.pdf`)}
  download={archivo}
  class:list={[
    'rotulo h-11 px-6 inline-flex items-center gap-3 border transition-colors',
    estilos,
    clase,
  ]}
>
  {t.portfolio.abrir}
  <span aria-hidden="true" class="w-5 h-px bg-current"></span>
</a>
