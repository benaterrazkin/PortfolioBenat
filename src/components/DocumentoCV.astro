---
import type { DatosCV } from '../data';
import { CODIGO_HREFLANG, type Idioma } from '../i18n/idiomas';
import { SITIO } from '../config/sitio';

/**
 * El currículum dibujado como un documento dentro de la propia web.
 *
 * No hay ningún PDF: el contenido sale de src/data/cv/<idioma>.json, así que
 * traducirlo es traducir un archivo de texto, y nunca se queda desfasado
 * respecto a los datos de contacto de src/config/sitio.ts.
 */
interface Props {
  cv: DatosCV;
  idioma: Idioma;
  oculto: boolean;
}

const { cv, idioma, oculto } = Astro.props;

const contacto = [
  SITIO.correo,
  ...(SITIO.telefono ? [SITIO.telefono] : []),
  SITIO.ubicacion,
].filter(Boolean);
---

<article
  class="documento-cv bg-papel text-tinta mx-auto w-full max-w-[52rem] border border-linea px-7 py-10 sm:px-14 sm:py-16"
  lang={CODIGO_HREFLANG[idioma]}
  data-documento={idioma}
  hidden={oculto}
>
  <header class="grid gap-6 sm:grid-cols-[1fr_auto] sm:items-end">
    <div>
      <p class="rotulo text-gris">{cv.titular}</p>
      <h3 class="mt-3 font-[family-name:var(--font-titulo)] text-4xl sm:text-5xl leading-[0.95] tracking-tight">
        {SITIO.nombreCompleto}
      </h3>
    </div>
    <ul class="grid gap-1 text-[0.8125rem] text-gris sm:text-right">
      {contacto.map((dato) => <li>{dato}</li>)}
    </ul>
  </header>

  <div class="mt-8 border-t border-tinta"></div>

  <!-- Perfil -->
  <section class="mt-8">
    <h4>{cv.secciones.perfil}</h4>
    <p class="mt-3 text-[0.9375rem] leading-relaxed max-w-[54ch]">{cv.resumen}</p>
  </section>

  <!-- Experiencia -->
  {
    cv.experiencia.length > 0 && (
      <section class="mt-10">
        <h4>{cv.secciones.experiencia}</h4>
        <ol class="mt-5">
          {cv.experiencia.map((etapa) => (
            <li class="grid gap-1.5 sm:grid-cols-[9rem_1fr] sm:gap-6 border-t border-linea-suave py-4 first:border-t-0 first:pt-0">
              <p class="text-[0.75rem] tracking-[0.08em] text-gris tabular-nums pt-0.5">
                {etapa.periodo}
              </p>
              <div>
                <p class="font-[family-name:var(--font-titulo)] text-base leading-snug">
                  {etapa.puesto}
                </p>
                <p class="text-[0.9375rem]">
                  {etapa.entidad}
                  {etapa.lugar && <span class="text-gris"> · {etapa.lugar}</span>}
                </p>
                {etapa.detalle && <p class="mt-1 text-[0.8125rem] text-gris">{etapa.detalle}</p>}
                {etapa.puntos.length > 0 && (
                  <ul class="mt-2.5 space-y-1.5">
                    {etapa.puntos.map((punto: string) => (
                      <li class="relative pl-5 text-[0.875rem] text-gris leading-relaxed">
                        <span
                          class="absolute left-0 top-[0.7em] w-2.5 h-px bg-trazo"
                          aria-hidden="true"
                        />
                        {punto}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <!-- Educación -->
  {
    cv.estudios.length > 0 && (
      <section class="mt-10">
        <h4>{cv.secciones.estudios}</h4>
        <ol class="mt-5">
          {cv.estudios.map((estudio) => (
            <li class="grid gap-1.5 sm:grid-cols-[9rem_1fr] sm:gap-6 border-t border-linea-suave py-4 first:border-t-0 first:pt-0">
              <p class="text-[0.75rem] tracking-[0.08em] text-gris tabular-nums pt-0.5">
                {estudio.periodo}
              </p>
              <div>
                <p class="font-[family-name:var(--font-titulo)] text-base leading-snug">
                  {estudio.titulo}
                </p>
                <p class="text-[0.9375rem] text-gris">{estudio.centro}</p>
                {estudio.nota && <p class="mt-1 text-[0.8125rem] text-gris">{estudio.nota}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <!-- Programas, habilidades, idiomas y otros datos -->
  <div class="mt-10 grid gap-10 sm:grid-cols-2">
    {
      cv.programas.length > 0 && (
        <section>
          <h4>{cv.secciones.programas}</h4>
          <ul class="mt-4 space-y-1.5">
            {cv.programas.map((programa) => (
              <li class="relative pl-5 text-[0.9375rem]">
                <span class="absolute left-0 top-[0.7em] w-2.5 h-px bg-trazo" aria-hidden="true" />
                {programa}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      cv.habilidades.length > 0 && (
        <section>
          <h4>{cv.secciones.habilidades}</h4>
          <ul class="mt-4 space-y-1.5">
            {cv.habilidades.map((habilidad) => (
              <li class="relative pl-5 text-[0.9375rem]">
                <span class="absolute left-0 top-[0.7em] w-2.5 h-px bg-trazo" aria-hidden="true" />
                {habilidad}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      cv.idiomas.length > 0 && (
        <section>
          <h4>{cv.secciones.idiomas}</h4>
          <dl class="mt-4 space-y-1.5 text-[0.9375rem]">
            {cv.idiomas.map((lengua) => (
              <div class="flex items-baseline gap-2">
                <dt>{lengua.lengua}</dt>
                <dd class="flex-1 text-gris text-[0.875rem] border-b border-dotted border-linea text-right">
                  {lengua.nivel}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      cv.otros.length > 0 && (
        <section>
          <h4>{cv.secciones.otros}</h4>
          <dl class="mt-4 space-y-3 text-[0.9375rem]">
            {cv.otros.map((dato) => (
              <div>
                <dt class="rotulo text-gris">{dato.etiqueta}</dt>
                <dd class="mt-1">{dato.valor}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }
  </div>
</article>

<style>
  .documento-cv h4 {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-tinta);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-trazo);
    display: block;
  }

  /* Al imprimir se ve solo el currículum, sin la ventana que lo envuelve. */
  @media print {
    .documento-cv {
      border: 0;
      max-width: none;
      padding: 0;
    }
  }
</style>
