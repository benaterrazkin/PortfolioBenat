---
/**
 * Encabezado de una sección de la portada. Es como TituloPagina, pero con
 * <h2>: en una web de una sola página solo puede haber un <h1>, que es el
 * nombre de Beñat, y todo lo demás cuelga de él.
 *
 * Sin número de sección encima: el título habla solo, y el orden de la
 * página no es información que el visitante necesite.
 */
interface Props {
  titulo: string;
  entradilla?: string;
}

const { titulo, entradilla } = Astro.props;
---

<div class="contenedor pt-12 pb-8 md:pt-16 md:pb-10">
  <h2 class="font-[family-name:var(--font-titulo)] text-4xl md:text-5xl leading-[0.95] tracking-tight">
    {titulo}
  </h2>
  {entradilla && <p class="mt-4 max-w-[48ch] text-lg text-gris leading-relaxed">{entradilla}</p>}
</div>
