---
import TapaCuaderno from './TapaCuaderno.astro';
import { cuadernos } from '../data/cuaderno';
import { textos, formatear } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';

/**
 * La pila de cuadernos: un cuaderno cerrado por proyecto, con su tapa de
 * corcho, su cinta de color y su boceto, en las mismas proporciones que
 * tiene por dentro (A4 apaisado).
 *
 * Con ratón, los cuadernos están superpuestos en fila: de cada uno asoma
 * la cinta, el número y el principio del título. Al pasar por uno, los
 * siguientes se apartan y se ve entero; al salir, vuelven a la pila. En
 * pantallas táctiles o estrechas, la fila se desliza de lado.
 *
 * Cada cuaderno es un enlace a #cuaderno-<id>: VisorCuaderno.astro lo abre
 * en grande, cerrado, con esta misma tapa.
 */
interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos(idioma);
const lista = cuadernos(idioma);
---

<nav id="estante" class="pila" aria-label={t.inicio.estante} style={`--libros:${lista.length}`}>
  <ul class="pila-fila">
    {
      lista.map((c) => {
        const tapa = c.caras.find((cara) => cara.tipo === 'tapa');
        return (
          <li>
            <a
              href={`#${c.ancla}`}
              class="libro"
              style={c.lomo ? `--lomo:${c.lomo}` : undefined}
              data-libro={c.id}
            >
              {tapa && tapa.tipo === 'tapa' && (
                <TapaCuaderno
                  numero={c.numero}
                  titulo={tapa.titulo}
                  claves={tapa.claves}
                  herramientas={tapa.herramientas}
                  lamina={tapa.lamina}
                  rotuloHueco={t.cuaderno.diagrama}
                />
              )}
              <span class="sr-only">{formatear(t.cuaderno.irA, { titulo: c.titulo })}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .pila {
    container-type: inline-size;
  }

  .pila-fila {
    display: flex;
  }

  /* El cuaderno cerrado: corcho, la cinta del lomo a la izquierda y la
     sombra de estar apoyado en la mesa. */
  .libro {
    --lomo-defecto: var(--color-lomo);
    position: relative;
    display: block;
    aspect-ratio: 297 / 210;
    background-color: var(--color-corcho);
    box-shadow:
      0 2px 4px rgb(20 22 26 / 0.08),
      0 10px 24px rgb(20 22 26 / 0.12);
    transition:
      transform 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }
  .libro::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: 0;
    width: clamp(0.75rem, 6%, 2.5rem);
    background-color: var(--lomo, var(--lomo-defecto));
    box-shadow: inset -1px 0 0 rgb(20 22 26 / 0.18);
  }
  .libro:focus-visible {
    outline: 2px solid var(--color-tinta);
    outline-offset: 4px;
  }
  .libro:active {
    transform: scale(0.99);
  }

  /* --- Táctil o estrecho: una fila que se desliza --- */
  .pila-fila {
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-block: 0.5rem 1.5rem;
  }
  .pila-fila::-webkit-scrollbar {
    display: none;
  }
  .pila-fila li {
    flex: 0 0 82%;
    scroll-snap-align: start;
  }

  /* --- Con ratón y sitio: la pila --- */
  @media (hover: hover) and (pointer: fine) and (width >= 48rem) {
    .pila {
      /* Lo que mide cada cuaderno y lo que asoma de cada uno: los seis
         caben justos a lo ancho, superpuestos. */
      --ancho: 38cqw;
      --paso: calc((100cqw - var(--ancho)) / (var(--libros) - 1));
      --solape: calc(var(--ancho) - var(--paso));
      overflow-x: clip;
      padding-block: 1rem 2rem;
    }
    .pila-fila {
      gap: 0;
      overflow: visible;
      scroll-snap-type: none;
      padding: 0;
    }
    .pila-fila li {
      flex: 0 0 var(--ancho);
    }
    .pila-fila li + li {
      margin-left: calc(-1 * var(--solape));
    }
    /* Cada cuaderno echa sombra sobre el anterior, como en una pila. */
    .libro {
      box-shadow:
        -6px 0 14px rgb(20 22 26 / 0.12),
        0 10px 24px rgb(20 22 26 / 0.12);
    }

    /* Al pasar por uno (o llegar con el tabulador), los de detrás se
       apartan y se ve entero; él se levanta un poco. */
    .pila-fila li:hover ~ li .libro,
    .pila-fila li:focus-within ~ li .libro {
      transform: translateX(var(--solape));
    }
    .pila-fila li:hover .libro,
    .pila-fila li:focus-within .libro {
      transform: translateY(-0.375rem);
      box-shadow:
        -6px 0 14px rgb(20 22 26 / 0.12),
        0 18px 34px rgb(20 22 26 / 0.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .libro {
      transition: none;
    }
    .pila-fila li:hover .libro,
    .pila-fila li:focus-within .libro,
    .libro:active {
      transform: none;
    }
  }
</style>
