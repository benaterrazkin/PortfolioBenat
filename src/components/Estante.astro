---
import { Image } from 'astro:assets';
import { cuadernos } from '../data/cuaderno';
import { textos, formatear } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';

/**
 * El estante: los proyectos como libros puestos de frente, igual que en
 * el escaparate de una librería. Cada tapa enseña el esquema conceptual
 * del proyecto y, al pasar por encima, se levanta y deja ver su imagen.
 *
 * Es el índice de la web. Cada libro es un enlace normal al cuaderno de su
 * proyecto (#cuaderno-<id>): con JavaScript, VisorCuaderno.astro lo abre
 * en grande encima de la página; sin él, la dirección sigue siendo buena.
 */
interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos(idioma);
const lista = cuadernos(idioma);
---

<nav id="estante" class="estante" aria-label={t.inicio.estante}>
  <ul class="balda">
    {
      lista.map((c) => (
        <li>
          <a
            href={`#${c.ancla}`}
            class="libro"
            style={c.lomo ? `--color:${c.lomo}` : undefined}
            data-libro={c.id}
          >
            <span class="libro-tapa">
              {c.diagrama ? (
                <Image
                  src={c.diagrama.fuente}
                  alt=""
                  widths={[320, 560]}
                  sizes="(min-width: 64rem) 15vw, (min-width: 40rem) 30vw, 45vw"
                  class="libro-esquema"
                  loading="lazy"
                />
              ) : (
                <span class="libro-numero-grande" aria-hidden="true">
                  {String(c.numero).padStart(2, '0')}
                </span>
              )}
              <Image
                src={c.portada.fuente}
                alt=""
                widths={[320, 640]}
                sizes="(min-width: 64rem) 15vw, (min-width: 40rem) 30vw, 45vw"
                class="libro-imagen"
                loading="lazy"
              />
            </span>

            <span class="libro-pie">
              <span class="libro-numero" aria-hidden="true">{String(c.numero).padStart(2, '0')}</span>
              <span class="libro-titulo">{c.titulo}</span>
              <span class="libro-lugar">{[c.nombreCorto, c.anio].join(' · ')}</span>
            </span>
            <span class="sr-only">{formatear(t.cuaderno.irA, { titulo: c.titulo })}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* La balda: los libros de pie sobre una línea de tinta. */
  .balda {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--color-tinta);
  }
  @media (width >= 40rem) {
    .balda { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (width >= 64rem) {
    .balda { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1.25rem; }
  }

  .libro {
    --color: var(--color-lomo);
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--color-tinta);
    transition: transform 350ms var(--ease-suave);
  }

  /* La tapa: papel, con el lomo de color asomando a la izquierda. */
  .libro-tapa {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 4;
    padding: 12% 10% 12% 16%;
    background-color: var(--color-hoja);
    box-shadow:
      inset 0.5rem 0 0 var(--color),
      0 1px 8px rgb(20 22 26 / 0.1);
    overflow: hidden;
    transition: box-shadow 350ms var(--ease-suave);
  }

  :global(.libro-esquema) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .libro-numero-grande {
    font-family: 'Barlow Condensed', var(--font-titulo);
    font-weight: 300;
    font-size: clamp(3rem, 8vw, 5rem);
    color: var(--color);
    transform: scaleY(1.35);
  }

  /* La imagen del proyecto espera encima, invisible. */
  :global(.libro-imagen) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 400ms var(--ease-suave);
  }

  .libro-pie {
    display: grid;
    gap: 0.125rem;
    padding-top: 0.875rem;
  }
  .libro-numero {
    font-family: 'Barlow Condensed', var(--font-titulo);
    font-weight: 300;
    font-size: 2rem;
    line-height: 1;
    color: var(--color);
    transform: scaleY(1.35);
    transform-origin: left bottom;
    margin-bottom: 0.5rem;
  }
  .libro-titulo {
    font-family: var(--font-titulo);
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1.25;
  }
  .libro-lugar {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gris);
  }

  /* Al apuntar o al enfocar: el libro se levanta y enseña el proyecto. */
  .libro:hover,
  .libro:focus-visible {
    transform: translateY(-0.5rem);
  }
  .libro:hover .libro-tapa,
  .libro:focus-visible .libro-tapa {
    box-shadow:
      inset 0.5rem 0 0 var(--color),
      0 14px 28px rgb(20 22 26 / 0.18);
  }
  .libro:hover :global(.libro-imagen),
  .libro:focus-visible :global(.libro-imagen) {
    opacity: 1;
  }
  .libro:focus-visible {
    outline: 2px solid var(--color-tinta);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .libro:hover,
    .libro:focus-visible {
      transform: none;
    }
  }
</style>
