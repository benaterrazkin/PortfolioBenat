---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Galeria from '../components/Galeria.astro';
import VisorImagenes from '../components/VisorImagenes.astro';
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';
import { ruta, rutaProyecto } from '../rutas';
import { proyecto, proyectos, imagen } from '../data';

interface Props {
  idioma: Idioma;
  proyectoId: string;
}
const { idioma, proyectoId } = Astro.props;
const t = textos(idioma);

const p = proyecto(proyectoId, idioma);

/* Enlace al siguiente proyecto, para poder recorrerlos sin volver atrás. */
const lista = proyectos(idioma);
const posicion = lista.findIndex((otro) => otro.id === p.id);
const siguiente = lista[(posicion + 1) % lista.length];

const ficha = [
  { etiqueta: t.proyectos.ficha.anio, valor: p.anio },
  ...(p.lugar ? [{ etiqueta: t.proyectos.ficha.lugar, valor: p.lugar }] : []),
  ...(p.tipo ? [{ etiqueta: t.proyectos.ficha.tipo, valor: p.tipo }] : []),
  ...(p.contexto ? [{ etiqueta: t.proyectos.ficha.contexto, valor: p.contexto }] : []),
  ...(p.herramientas.length > 0
    ? [{ etiqueta: t.proyectos.ficha.herramientas, valor: p.herramientas.join(', ') }]
    : []),
];
---

<Base
  idioma={idioma}
  pagina="proyectos"
  proyectoId={p.id}
  titulo={p.titulo}
  descripcion={p.subtitulo ?? p.texto[0] ?? p.titulo}
>
  <!-- Título -->
  <div class="border-b border-linea">
    <div class="contenedor pt-10 pb-10 md:pt-14 md:pb-14">
      <a
        href={ruta('proyectos', idioma)}
        class="rotulo text-gris inline-flex items-center gap-3 hover:text-tinta transition-colors"
      >
        <span aria-hidden="true" class="w-6 h-px bg-current"></span>
        {t.general.volver}
      </a>

      <h1 class="mt-8 font-[family-name:var(--font-titulo)] text-5xl md:text-7xl leading-[0.92] tracking-tight">
        {p.titulo}
      </h1>
      {p.subtitulo && <p class="mt-5 max-w-[52ch] text-lg text-gris leading-relaxed">{p.subtitulo}</p>}
    </div>
  </div>

  <div class="contenedor pt-12 md:pt-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_16rem] lg:gap-16 items-start">
      <!-- Texto -->
      <div class="max-w-[62ch]">
        {p.texto.map((parrafo) => <p class="mt-5 first:mt-0 text-lg leading-relaxed">{parrafo}</p>)}
      </div>

      <!-- Cajetín con los datos del proyecto -->
      <aside class="border border-linea lg:sticky lg:top-24">
        <h2 class="rotulo text-tinta px-4 py-2.5 border-b border-linea bg-papel-2">
          {t.proyectos.titulo}
        </h2>
        <dl class="divide-y divide-linea-suave">
          {
            ficha.map((dato) => (
              <div class="px-4 py-3">
                <dt class="rotulo text-gris">{dato.etiqueta}</dt>
                <dd class="mt-1 text-sm">{dato.valor}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>

    <!-- Portada a toda anchura -->
    <figure class="mt-14">
      <div class="border border-linea bg-papel-2 overflow-hidden">
        <button
          type="button"
          class="group block w-full"
          data-galeria={`proyecto-${p.id}`}
          data-grande={imagen(p.portada.archivo).src}
          data-alt={p.portada.alt}
          aria-label={`${t.proyectos.ampliar}: ${p.portada.alt}`}
        >
          <Image
            src={imagen(p.portada.archivo)}
            alt={p.portada.alt}
            widths={[640, 1024, 1600, 2000]}
            sizes="(min-width: 80rem) 72rem, 100vw"
            class="w-full h-auto transition-opacity duration-300 group-hover:opacity-90"
            loading="eager"
          />
        </button>
      </div>
      <figcaption class="mt-3 flex items-baseline gap-4 border-t border-linea-suave pt-2.5">
        <span class="indice">00</span>
        <span class="text-sm text-gris">{p.portada.pie ?? p.portada.alt}</span>
      </figcaption>
    </figure>

    <!-- Las demás imágenes -->
    <Galeria imagenes={p.imagenes} grupo={`proyecto-${p.id}`} idioma={idioma} />

    <!-- Siguiente proyecto -->
    {
      lista.length > 1 && (
        <nav class="mt-20 border-t border-tinta pt-5">
          <a href={rutaProyecto(siguiente.id, idioma)} class="group flex items-baseline justify-between gap-6">
            <span class="rotulo">{t.proyectos.ver}</span>
            <span class="font-[family-name:var(--font-titulo)] text-2xl md:text-3xl tracking-tight text-right group-hover:text-trazo transition-colors">
              {siguiente.titulo}
            </span>
          </a>
        </nav>
      )
    }
  </div>

  <VisorImagenes idioma={idioma} />
</Base>
