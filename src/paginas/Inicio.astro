---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BotonCV from '../components/BotonCV.astro';
import BotonPortfolio from '../components/BotonPortfolio.astro';
import VisorCV from '../components/VisorCV.astro';
import VisorPortfolio from '../components/VisorPortfolio.astro';
import VisorCuaderno from '../components/VisorCuaderno.astro';
import SeccionProyectos from '../components/SeccionProyectos.astro';
import SeccionContacto from '../components/SeccionContacto.astro';
import PuntosNavegacion from '../components/PuntosNavegacion.astro';
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';
import { rutaSeccion } from '../rutas';
import { SITIO } from '../config/sitio';
import retrato from '../assets/img/retrato.jpg';

/**
 * La web entera, corta y en un solo scroll: el nombre y la foto, el
 * estante con los proyectos y el contacto. Los cuadernos no están en la
 * página: se abren encima al elegir un libro (VisorCuaderno.astro).
 */
interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = textos(idioma);
---

<Base idioma={idioma} pagina="inicio">
  <!-- ---------------------------------------------------------------- -->
  <!--  Portada                                                          -->
  <!-- ---------------------------------------------------------------- -->
  <!-- Compacta a propósito: a la altura de un portátil tiene que asomar
       el estante, que es el trabajo. -->
  <section class="relative overflow-hidden" data-seccion="inicio">
    <div class="reticula absolute inset-0 opacity-60" aria-hidden="true"></div>

    <div class="contenedor relative pt-10 pb-10 md:pt-14 md:pb-12">
      <div class="grid gap-8 grid-cols-[1fr_7.5rem] sm:grid-cols-[1fr_11rem] lg:grid-cols-[1fr_13rem] lg:gap-16 items-start">
        <div class="min-w-0">
          <h1 class="font-[family-name:var(--font-titulo)] font-light text-[2.75rem] sm:text-6xl lg:text-7xl leading-[0.9] tracking-[-0.03em]">
            Beñat<br />Errazkin
          </h1>

          <!-- Lo que se recuerda de él: su manera de proyectar. -->
          <p class="mt-5 max-w-[34ch] font-[family-name:var(--font-titulo)] text-lg sm:text-xl leading-snug text-tinta">
            {t.inicio.lema}
          </p>
        </div>

        <!-- Retrato, enmarcado como una lámina. Las marcas de las esquinas
             van sobre el propio marco. -->
        <figure class="relative">
          <div class="relative border border-tinta p-1.5 sm:p-2 bg-papel">
            <Image
              src={retrato}
              alt={`${SITIO.nombreCompleto}, ${t.inicio.rotulo.toLowerCase()}`}
              widths={[240, 480, 640]}
              sizes="(min-width: 64rem) 13rem, (min-width: 40rem) 11rem, 7.5rem"
              class="w-full h-auto object-cover"
              loading="eager"
            />
            <span class="absolute -top-1.5 -left-1.5 w-3 h-3 border-t border-l border-trazo" aria-hidden="true"></span>
            <span class="absolute -top-1.5 -right-1.5 w-3 h-3 border-t border-r border-trazo" aria-hidden="true"></span>
            <span class="absolute -bottom-1.5 -left-1.5 w-3 h-3 border-b border-l border-trazo" aria-hidden="true"></span>
            <span class="absolute -bottom-1.5 -right-1.5 w-3 h-3 border-b border-r border-trazo" aria-hidden="true"></span>
          </div>
        </figure>
      </div>

      <div class="mt-8 h-px w-full bg-tinta" aria-hidden="true"></div>

      <div class="mt-7 flex flex-col gap-7 lg:flex-row lg:items-end lg:justify-between">
        <!-- Lo que se lee de un vistazo: el título primero, en tinta; lo
             demás, en gris. La presentación larga va en el PDF. -->
        <ul class="grid gap-2">
          {[...t.inicio.datos, SITIO.programas.join(' · ')].map((dato, i) => (
            <li class:list={['rotulo', i === 0 ? 'text-tinta' : 'text-gris']}>{dato}</li>
          ))}
        </ul>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href={rutaSeccion('contacto', idioma)}
            class="rotulo h-11 px-6 inline-flex items-center gap-3 border border-tinta bg-tinta text-papel hover:bg-papel hover:text-tinta pulsable"
          >
            {t.inicio.contacto}
            <span aria-hidden="true" class="w-5 h-px bg-current"></span>
          </a>
          <BotonCV idioma={idioma} tono="linea" />
          <BotonPortfolio idioma={idioma} tono="linea" />
        </div>
      </div>
    </div>
  </section>

  <SeccionProyectos idioma={idioma} />
  <SeccionContacto idioma={idioma} />

  <!-- El marcador del menú y las tres ventanas —cuadernos, currículum y
       portfolio—: una de cada por página, o habría identificadores repetidos. -->
  <PuntosNavegacion />
  <VisorCuaderno idioma={idioma} />
  <VisorCV idioma={idioma} />
  <VisorPortfolio idioma={idioma} />
</Base>
