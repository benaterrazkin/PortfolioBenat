---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TituloPagina from '../components/TituloPagina.astro';
import { textos, formatear } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';
import { rutaProyecto } from '../rutas';
import { proyectos, imagen } from '../data';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = textos(idioma);

const lista = proyectos(idioma);
---

<Base idioma={idioma} pagina="proyectos">
  <TituloPagina indice="02" titulo={t.proyectos.titulo} entradilla={t.proyectos.entradilla} />

  {
    lista.length === 0 ? (
      <p class="contenedor py-24 text-gris">{t.proyectos.vacio}</p>
    ) : (
      <ul class="contenedor py-14 md:py-20 grid gap-16 md:gap-24">
        {lista.map((p, i) => (
          <li>
            <a href={rutaProyecto(p.id, idioma)} class="group grid gap-6 md:grid-cols-[1fr_20rem] md:gap-12 items-start">
              <div class="overflow-hidden border border-linea bg-papel-2 order-2 md:order-1">
                <Image
                  src={imagen(p.portada.archivo)}
                  alt={p.portada.alt}
                  widths={[640, 1024, 1600]}
                  sizes="(min-width: 64rem) 52rem, 100vw"
                  class="w-full aspect-[16/9] object-cover transition-transform duration-500 ease-[var(--ease-suave)] group-hover:scale-[1.015]"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </div>

              <div class="order-1 md:order-2 md:pt-2">
                <div class="flex items-baseline gap-4 border-b border-linea pb-3">
                  <span class="indice">{String(i + 1).padStart(2, '0')}</span>
                  <span class="rotulo text-gris ml-auto tabular-nums">{p.anio}</span>
                </div>

                <h2 class="mt-4 font-[family-name:var(--font-titulo)] text-3xl md:text-4xl leading-[1.02] tracking-tight group-hover:text-trazo transition-colors">
                  {p.titulo}
                </h2>

                {p.subtitulo && <p class="mt-3 text-gris leading-relaxed">{p.subtitulo}</p>}

                <dl class="mt-5 grid gap-2 text-sm">
                  {p.lugar && (
                    <div class="flex gap-3 border-t border-linea-suave pt-2">
                      <dt class="rotulo text-gris w-24 shrink-0">{t.proyectos.ficha.lugar}</dt>
                      <dd class="text-gris">{p.lugar}</dd>
                    </div>
                  )}
                  {p.tipo && (
                    <div class="flex gap-3 border-t border-linea-suave pt-2">
                      <dt class="rotulo text-gris w-24 shrink-0">{t.proyectos.ficha.tipo}</dt>
                      <dd class="text-gris">{p.tipo}</dd>
                    </div>
                  )}
                  {p.contexto && (
                    <div class="flex gap-3 border-t border-linea-suave pt-2">
                      <dt class="rotulo text-gris w-24 shrink-0">{t.proyectos.ficha.contexto}</dt>
                      <dd class="text-gris">{p.contexto}</dd>
                    </div>
                  )}
                </dl>

                <p class="mt-6 rotulo text-gris inline-flex items-center gap-3 group-hover:text-tinta transition-colors">
                  {t.proyectos.ver}
                  <span aria-hidden="true" class="w-6 h-px bg-current" />
                </p>
                <p class="mt-2 text-xs text-gris-claro">
                  {p.imagenes.length + 1 === 1
                    ? t.proyectos.unaImagen
                    : formatear(t.proyectos.variasImagenes, { n: p.imagenes.length + 1 })}
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
