---
import '@fontsource-variable/inter';
import '@fontsource-variable/work-sans';
/* Solo para los números de proyecto: finos y condensados. */
import '@fontsource/barlow-condensed/latin-300.css';
import '../styles/global.css';

import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { textos } from '../i18n/ui';
import {
  CODIGO_HREFLANG,
  IDIOMAS_PUBLICADOS,
  IDIOMA_DE_RESERVA,
  type Idioma,
} from '../i18n/idiomas';
import { ruta, recurso, type ClavePagina } from '../rutas';
import { SITIO } from '../config/sitio';

interface Props {
  idioma: Idioma;
  pagina: ClavePagina;
  /** Sustituye al título por defecto de la página. */
  titulo?: string;
  descripcion?: string;
}

const { idioma, pagina, titulo, descripcion } = Astro.props;
const t = textos(idioma);

const tituloPagina = titulo ?? t.meta[pagina].titulo;
const desc = descripcion ?? t.meta[pagina].descripcion;
const tituloCompleto =
  pagina === 'inicio' ? `${SITIO.nombre} — ${tituloPagina}` : `${tituloPagina} · ${SITIO.nombre}`;

/** La dirección de esta misma página en un idioma cualquiera. */
const direccion = (otro: Idioma) => ruta(pagina, otro);

const canonica = new URL(direccion(idioma), Astro.site).toString();
const imagenCompartir = new URL(recurso('compartir.jpg'), Astro.site).toString();
const alternativas = IDIOMAS_PUBLICADOS.map((otro) => ({
  hreflang: CODIGO_HREFLANG[otro],
  href: new URL(direccion(otro), Astro.site).toString(),
}));

const persona = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITIO.nombreCompleto,
  jobTitle: t.meta.inicio.titulo,
  description: t.meta.inicio.descripcion,
  email: `mailto:${SITIO.correo}`,
  url: new URL(ruta('inicio', idioma), Astro.site).toString(),
  knowsLanguage: ['eu', 'es', 'en'],
  ...(SITIO.linkedin || SITIO.instagram
    ? { sameAs: [SITIO.linkedin, SITIO.instagram].filter(Boolean) }
    : {}),
};
---

<!doctype html>
<html lang={CODIGO_HREFLANG[idioma]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonica} />
    {alternativas.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(direccion(IDIOMA_DE_RESERVA), Astro.site).toString()} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content={CODIGO_HREFLANG[idioma].replace('-', '_')} />
    <!-- La imagen al compartir el enlace: la genera src/pages/compartir.jpg.ts. -->
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITIO.nombreCompleto}, ${t.meta.inicio.titulo.toLowerCase()}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagenCompartir} />

    <meta name="theme-color" content="#fbfaf8" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href={recurso('favicon.svg')} type="image/svg+xml" />

    <script type="application/ld+json" set:html={JSON.stringify(persona)} />

    <!--
      Marca que hay JavaScript ANTES de que se pinte nada. El cuaderno de
      los proyectos solo se monta con esta clase puesta: sin ella, sus
      hojas se leen una debajo de otra. Va aquí, y no en un script normal,
      porque los de Astro son diferidos y se verían las hojas apiladas
      durante un instante.
    -->
    <script is:inline>document.documentElement.classList.add('con-js');</script>
  </head>

  <body class="min-h-dvh flex flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-tinta focus:text-papel focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
    >
      {t.general.saltarAlContenido}
    </a>

    <Cabecera idioma={idioma} pagina={pagina} />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <Pie idioma={idioma} />
  </body>
</html>
